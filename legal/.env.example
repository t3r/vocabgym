# Legal document values — copy to legal/.env and fill in.
# legal/.env is gitignored (contains personal data). Used by
# scripts/render_legal.py to generate the real legal/*.html from the
# *.example.html templates.

# Responsible party / operator (Verantwortlicher, Impressum)
LEGAL_NAME=Max Mustermann
LEGAL_STREET=Musterstraße 1
LEGAL_CITY=12345 Musterstadt
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=kontakt@example.org

# Represented by (Impressum "Vertreten durch")
LEGAL_REPRESENTATIVE=Max Mustermann

# Optional phone number for the Impressum ("" to leave blank)
LEGAL_PHONE=

# Responsible for content, if different from above ("" -> falls back to name/address)
LEGAL_CONTENT_RESPONSIBLE=

# Data protection officer, if any ("" -> shown as 'nicht benannt')
LEGAL_DPO=

# Privacy policy 'Stand' date (DD.MM.YYYY). Leave empty to use today's date.
LEGAL_PRIVACY_DATE=
