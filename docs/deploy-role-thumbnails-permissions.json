{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SqsQueueLifecycleForThumbnails",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:eu-central-1:730335610692:vocabtrainer-thumbnail-queue-*",
        "arn:aws:sqs:eu-central-1:730335610692:vocabtrainer-thumbnail-dlq-*"
      ]
    }
  ]
}
