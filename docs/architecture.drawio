        </mxCell>
        <mxCell id="fn-extractworker" value="Extraction Worker&#10;(Textract OCR → Bedrock Nova Pro,&#10;dedup by target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp-workers">
          <mxGeometry x="15" y="35" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fn-thumbworker" value="Thumbnail Worker&#10;(Nova Pro prompt →&#10;Stable Image Core, us-west-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp-workers">
          <mxGeometry x="225" y="35" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== MESSAGING (between compute and data) ===================== -->
