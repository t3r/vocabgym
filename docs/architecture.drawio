        </mxCell>
        <mxCell id="e-api-cognito-l" value="JWT authorizer" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-api-cognito">
          <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- API Gateway -> compute group (single blue trunk into the domain group) -->
        <mxCell id="e-api-compute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="apigw" target="grp-compute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-compute-l" value="invoke handler (proxy)" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-api-compute">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Compute -> Data (single grey trunk to reduce crossings) -->
        <mxCell id="e-compute-data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=3;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="grp-compute" target="grp-data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-compute-data-l" value="read / write items&#10;(key + GSI queries, no scans)" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-compute-data">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ===== Extraction pipeline (green) ===== -->
        <!-- Upload writes scan to S3 -->
        <mxCell id="e-upload-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="fn-upload" target="s3images">
