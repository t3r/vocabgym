          </mxGeometry>
        </mxCell>
        <mxCell id="e-thumbworker-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=1;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="fn-thumbworker" target="s3images">
