        <mxCell id="fn-image" value="Image Handler&#10;POST /images/thumbnail&#10;GET /images/thumbnail/{s}/{i}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp-c-media">
          <mxGeometry x="10" y="95" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fn-icon" value="Icon Handler&#10;(EventBridge: S3 ObjectCreated&#10;→ identicons)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp-c-media">
