          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1700" y="940" /></Array>
          </mxGeometry>
        </mxCell>
        <!-- Extraction worker reads scan from S3 -->
        <mxCell id="e-extractworker-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="fn-extractworker" target="s3images">
          <mxGeometry relative="1" as="geometry" />
