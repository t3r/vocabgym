        <!-- Extraction handler enqueues -->
        <mxCell id="e-extract-sqs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2d862d;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="fn-extract" target="sqs-extract">
