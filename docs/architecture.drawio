        </mxCell>
        <mxCell id="cognito" value="Cognito User Pool&#10;(OAuth2 PKCE, ID token,&#10;teachers group; invite-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="grp-edge">
