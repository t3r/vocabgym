        </mxCell>
        <mxCell id="e-spa-api-l" value="REST /… (Bearer ID token)" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-spa-api">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <!-- API GW validates with Cognito -->
        <mxCell id="e-api-cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=1;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="apigw" target="cognito">
