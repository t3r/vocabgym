          <mxGeometry x="250" y="250" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fn-polly" value="Polly Handler&#10;GET /tts/voices&#10;POST /tts/synthesize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp-c-media">
          <mxGeometry x="10" y="35" width="180" height="50" as="geometry" />
