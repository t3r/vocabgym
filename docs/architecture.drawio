        </mxCell>

        <mxCell id="grp-ext" value="External AI / Voice (Amazon Bedrock, Textract, Polly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
