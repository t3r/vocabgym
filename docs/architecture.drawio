        <mxCell id="s3front" value="S3: Frontend Bucket&#10;(static Vue build, OAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="grp-edge">
