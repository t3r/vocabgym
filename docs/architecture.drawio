        <!-- ===== Icon pipeline (EventBridge, green) ===== -->
        <mxCell id="e-s3-icon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2d862d;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s3images" target="fn-icon">
