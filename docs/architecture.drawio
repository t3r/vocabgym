        <!-- ============================================================= -->
        <!-- ===================== EDGES ================================= -->
        <!-- ============================================================= -->

        <!-- Client -> Edge (request path, blue) -->
        <mxCell id="e-spa-cf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.4;" edge="1" parent="1" source="spa" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-spa-cf-l" value="statische App laden" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-spa-cf">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e-cf-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=1;" edge="1" parent="1" source="cloudfront" target="s3front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r53-cf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=1;dashed=1;" edge="1" parent="1" source="route53" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-spa-cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="spa" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-spa-cognito-l" value="OAuth2 login" style="text;html=1;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-spa-cognito">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
