        <!-- async workers -->
        <mxCell id="grp-workers" value="Async Workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=top;fontSize=11;dashed=1;" vertex="1" parent="grp-compute">
