<mxfile host="app.diagrams.net" agent="kiro" version="24.0.0">
  <diagram id="vocabgym-arch" name="VocabGym Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="VocabGym — Serverless Architecture (AWS eu-central-1, SAM stack vocabtrainer-&lt;env&gt;)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Flow legend:&#10;— blue: user request path (HTTPS/REST)&#10;— green: async pipeline (SQS → worker)&#10;— orange: external AI / voice (Bedrock, Textract, Polly)&#10;— grey: data access (Lambda ↔ DynamoDB / S3)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;spacing=6;strokeColor=#999999;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="18" width="440" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== CLIENT ===================== -->
        <mxCell id="grp-client" value="Client (Browser / iPad / Android Tablet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="Vue 3 SPA&#10;(Vite, Pinia, Tailwind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="grp-client">
          <mxGeometry x="20" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="localstore" value="localStorage&#10;(live session buffer,&#10;voice pref, tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="grp-client">
          <mxGeometry x="20" y="120" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== EDGE / HOSTING ===================== -->
