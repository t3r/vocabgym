        <!-- SPA -> API Gateway (REST, blue, main request path) -->
        <mxCell id="e-spa-api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3366cc;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="spa" target="apigw">
